{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanjai.local/schemas/reply_pack.json",
  "title": "ReplyPack",
  "description": "Offline reply pack for Nova OfflineProvider. Openers are soft-asks keyed by time_band × opener_weather (not clothing weather_band). Intent entries carry variants; reply is the legacy first line.",
  "type": "object",
  "required": ["tip_id", "locale", "entries", "openers", "updated_at"],
  "additionalProperties": false,
  "properties": {
    "tip_id": { "type": "string" },
    "locale": { "type": "string", "enum": ["zh-HK", "zh-CN", "en"] },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["intent", "variants"],
        "additionalProperties": false,
        "properties": {
          "intent": {
            "type": "string",
            "enum": ["care", "faq_what", "faq_why", "faq_busy", "faq_offline", "encourage"]
          },
          "triggers": { "type": "array", "items": { "type": "string" } },
          "reply": {
            "type": "string",
            "description": "Legacy single line. Seeds set this to variants[0]."
          },
          "variants": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "openers": {
      "type": "array",
      "minItems": 16,
      "description": "One cell per time_band × opener_weather. Soft-ask greetings, not clothing advice.",
      "items": {
        "type": "object",
        "required": ["time_band", "opener_weather", "variants"],
        "additionalProperties": false,
        "properties": {
          "time_band": {
            "type": "string",
            "enum": ["morning", "afternoon", "evening", "late_night"]
          },
          "opener_weather": {
            "type": "string",
            "enum": ["clear", "cloudy", "rain", "extreme"]
          },
          "variants": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
