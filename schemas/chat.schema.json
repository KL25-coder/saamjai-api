{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanjai.local/schemas/chat.json",
  "title": "Chat",
  "definitions": {
    "ChatRequest": {
      "type": "object",
      "required": ["message", "tip_id", "locale"],
      "properties": {
        "message": { "type": "string", "maxLength": 2000 },
        "tip_id": { "type": "string" },
        "locale": { "type": "string", "enum": ["zh-HK", "zh-CN", "en"] },
        "client_message_id": { "type": "string", "format": "uuid" },
        "history": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["role", "content"],
            "properties": {
              "role": { "type": "string", "enum": ["user", "assistant"] },
              "content": { "type": "string" }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "ChatResponse": {
      "type": "object",
      "required": ["reply", "tip_id", "model_tier", "updated_at"],
      "properties": {
        "reply": { "type": "string" },
        "tip_id": { "type": "string" },
        "model_tier": { "type": "string", "enum": ["haiku", "gpt-4o-mini", "other-mini"] },
        "finish_reason": { "type": "string", "enum": ["stop", "length", "filtered"] },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
